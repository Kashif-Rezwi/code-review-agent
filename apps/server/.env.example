# Server
PORT=4000

# Database (Neon — pgvector)
DATABASE_URL=
DIRECT_URL=

# AI — chat tiers are router-pluggable via AI_ROUTER (restart to switch):
#   vercel-gateway (default) → Vercel AI Gateway, one key reaches many providers
#                              with zero markup: https://vercel.com/docs/ai-gateway
#   openrouter               → OpenRouter, large free/cheap model catalog:
#                              https://openrouter.ai/keys
# AI_ROUTER=vercel-gateway
# Vercel AI Gateway key — ALWAYS required: it serves the embedding tier in every
# configuration, plus chat tiers when AI_ROUTER=vercel-gateway.
AI_GATEWAY_API_KEY=
# OpenRouter key — required only when AI_ROUTER=openrouter.
OPENROUTER_API_KEY=
# Per-tier model selection, as model IDs in the ACTIVE router's catalog naming
# (defaults are free-tier on both routers; OpenRouter's free catalog rotates —
# see https://openrouter.ai/models?q=free).
# Review tier → code review agent, PR cluster workers, synthesis (quality-critical).
# AI_REVIEW_MODEL=deepseek/deepseek-v4-flash-0731
# Fast tier → PR clustering planner + follow-up chat (cheapest, non-critical).
# AI_FAST_MODEL=deepseek/deepseek-v4-flash-0731
# Embedding tier → served by the Vercel AI Gateway regardless of AI_ROUTER.
# MUST stay a Gemini 1536-dim model to match vector(1536) and keep existing RAG
# vectors comparable (changing provider/model = re-upload docs).
# AI_EMBEDDING_MODEL=google/gemini-embedding-001
# Parallel worker agents for clustered PR reviews (1-8, default 3). Every worker
# counts against the same quota budget — lower this if you see 429s.
# AI_WORKER_CONCURRENCY=3

# GitHub — server-side PAT used to fetch PR data (optional; anonymous access otherwise)
GITHUB_TOKEN=
GITHUB_TOKEN_CACHE_TTL_MS=300000

# GitHub OAuth — client-only (NextAuth). The server never reads these;
# they live here only as a deployment reference. Set them in apps/client/.env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

# ── Not implemented (reserved for future milestones) ──────────────
# No code reads the variables below today — see AI-CodeReview-SaaS-Masterplan.md (roadmap).
JWT_SECRET=            # legacy — auth uses GitHub tokens directly; no JWT is issued
JWT_EXPIRES_IN=7d      # legacy — same as above
GROQ_API_KEY=
HELICONE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
