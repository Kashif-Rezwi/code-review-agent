generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ── Auth: Users ──────────────────────────────────────────────────────────────
// Keyed by GitHub numeric user ID (stored as string).
// findOrCreate on every authenticated request via AuthGuard.

model User {
  id            String   @id          // GitHub user ID as string, e.g. "12345678"
  login         String   @unique      // GitHub username, e.g. "kashifrezwi"
  name          String?
  email         String?
  avatarUrl     String?
  creditBalance Int      @default(0)  // prepaid review credits
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        PaymentOrder[]
  ledgerEntries CreditLedger[]
}

// ── RAG: Coding Standards ───────────────────────────────────────────────────

model Document {
  id        String          @id @default(cuid())
  userId    String          // GitHub user ID; existing rows with "default" are ignored
  name      String
  chunks    DocumentChunk[]
  createdAt DateTime        @default(now())

  @@index([userId])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1536)")?
  metadata   Json?

  @@index([documentId])
}

// ── Memory: Review History ───────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED
}

enum ReviewType {
  CODE
  PR
}

enum DispatchStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
  CANCELLED
}

model Review {
  id               String         @id @default(cuid())
  userId           String         // GitHub user ID
  type             ReviewType
  status           ReviewStatus   @default(PENDING)
  input            String         @db.Text
  summary          String?        @db.Text   // null until the AI pipeline completes
  score            Int?                      // null until the AI pipeline completes
  positives        String[]       @default([])
  appliedStandards String[]       @default([])
  traceLog         Json?          // ordered array of ReviewStreamEvent; null for pre-migration rows
  coverage         Json?          // PR file/cluster coverage metadata; null for legacy/code reviews
  issues           Issue[]
  conversations    Conversation[]
  dispatch         ReviewDispatch?
  createdAt        DateTime       @default(now())

  @@index([userId])
}

model ReviewDispatch {
  id           String         @id @default(cuid())
  reviewId     String         @unique
  review       Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  status       DispatchStatus @default(PENDING)
  attempts     Int            @default(0)
  availableAt  DateTime       @default(now())
  lockedUntil  DateTime?
  lastError    String?        @db.Text
  dispatchedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, availableAt])
}

model Issue {
  id             String  @id @default(cuid())
  reviewId       String
  review         Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type           String
  severity       String
  title          String
  location       String
  description    String  @db.Text
  recommendation String  @db.Text

  @@index([reviewId])
}

model Conversation {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// ── Payments: Credits & Orders ───────────────────────────────────────────────

enum OrderStatus {
  CREATED
  CAPTURED
  FAILED
  EXPIRED
}

enum LedgerEntryType {
  FREE_GRANT
  PURCHASE
  CONSUMPTION
  CONSUMPTION_REFUND
}

model PaymentOrder {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  packageId         String                    // credit package key, e.g. "50", "200", "500"
  amountPaise       Int                       // Razorpay amounts are always integer paise
  currency          String      @default("INR")
  creditsGranted    Int         @default(0)   // 0 until CAPTURED; set atomically during transition
  status            OrderStatus @default(CREATED)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  events        PaymentEvent[]
  ledgerEntries CreditLedger[]

  @@index([userId])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String        @id @default(cuid())
  razorpayEventId String        @unique       // x-razorpay-event-id header — idempotency key
  razorpayOrderId String?
  order           PaymentOrder? @relation(fields: [razorpayOrderId], references: [razorpayOrderId])
  eventType       String                      // "order.paid", "payment.failed", "order.paid.amount_mismatch"
  payload         Json                        // full raw Razorpay event body (stored after size check)
  processedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([razorpayOrderId])
}

model CreditLedger {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  type         LedgerEntryType
  amount       Int             // positive = credits in (grant/purchase/refund), negative = credits out
  balanceAfter Int             // snapshot of User.creditBalance after this entry (read from DB, never computed)
  orderId      String?         // set for PURCHASE entries
  order        PaymentOrder?   @relation(fields: [orderId], references: [id])
  reviewId     String?         // set for CONSUMPTION / CONSUMPTION_REFUND entries
  description  String?         // human-readable, e.g. "PR review", "Code review"
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
}
