generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ── Auth: Users ──────────────────────────────────────────────────────────────
// Keyed by GitHub numeric user ID (stored as string).
// findOrCreate on every authenticated request via AuthGuard.

model User {
  id        String   @id          // GitHub user ID as string, e.g. "12345678"
  login     String   @unique      // GitHub username, e.g. "kashifrezwi"
  name      String?
  email     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── RAG: Coding Standards ───────────────────────────────────────────────────

model Document {
  id        String          @id @default(cuid())
  userId    String          // GitHub user ID; existing rows with "default" are ignored
  name      String
  chunks    DocumentChunk[]
  createdAt DateTime        @default(now())
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
}

// ── Memory: Review History ───────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED
}

enum ReviewType {
  CODE
  PR
}

enum DispatchStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
  CANCELLED
}

model Review {
  id               String         @id @default(cuid())
  userId           String         // GitHub user ID
  type             ReviewType
  status           ReviewStatus   @default(PENDING)
  input            String         @db.Text
  summary          String?        @db.Text   // null until the AI pipeline completes
  score            Int?                      // null until the AI pipeline completes
  positives        String[]       @default([])
  appliedStandards String[]       @default([])
  traceLog         Json?          // ordered array of ReviewStreamEvent; null for pre-migration rows
  coverage         Json?          // PR file/cluster coverage metadata; null for legacy/code reviews
  issues           Issue[]
  conversations    Conversation[]
  dispatch         ReviewDispatch?
  createdAt        DateTime       @default(now())
}

model ReviewDispatch {
  id           String         @id @default(cuid())
  reviewId     String         @unique
  review       Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  status       DispatchStatus @default(PENDING)
  attempts     Int            @default(0)
  availableAt  DateTime       @default(now())
  lockedUntil  DateTime?
  lastError    String?        @db.Text
  dispatchedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, availableAt])
}

model Issue {
  id             String  @id @default(cuid())
  reviewId       String
  review         Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type           String
  severity       String
  title          String
  location       String
  description    String  @db.Text
  recommendation String  @db.Text
}

model Conversation {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())
}
